# ---- Runtime ----
NODE_ENV=development
PORT=4000

# ---- Database ----
# Local:  mongodb://127.0.0.1:27017/roadmap_portal
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/roadmap_portal?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/roadmap_portal

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Set false to let unverified accounts sign in (handy while reviewing)
REQUIRE_EMAIL_VERIFICATION=true

# ---- Cookies / CORS ----
# Comma-separated list of origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:5173
# Public URL of the frontend, used to build verification / reset links
CLIENT_URL=http://localhost:5173
# "lax" for same-site dev, "none" (with COOKIE_SECURE=true) when API and UI are on different domains
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ---- Seed ----
SEED_ADMIN_EMAIL=admin@roadmap.test
SEED_ADMIN_PASSWORD=Admin@12345
